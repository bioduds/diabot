<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ replaces windowBackground with its own SplashScreen API, which
         otherwise defaults to a white background regardless of launch_background.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <!-- Our launcher icon isn't a split adaptive icon, so the system adds a
             white backing plate behind it unless told otherwise. -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background</item>
    </style>
</resources>
