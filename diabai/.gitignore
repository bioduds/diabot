# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Large local model weights (fetch separately, do not commit)
assets/models/*.gguf
assets/models/*.bin
assets/models/*.onnx
assets/stt/*.onnx
assets/stt/*.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug

# Generated FSM handoff archive (docs/create_fsm_handoff_zip.sh); regenerate,
# do not commit
/docs/zip/
/android/app/profile
/android/app/release

# Firebase config (contains project-specific api_key, keep local only)
android/app/google-services.json
macos/Runner/GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist
